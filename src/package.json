{
  "name": "kahootclone",
  "version": "1.0.13",
  "description": "A kahoot website clone",
  "main": "index.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "test:i18n": "playwright test",
    "lint": "node scripts/lint.js",
    "normalize-tags": "node scripts/normalize-tags.js",
    "seed:dev": "node scripts/seed-dev-data.js",
    "unseed:dev": "node scripts/seed-dev-data.js --remove",
    "test": "node --test test/unit/*.test.js test/integration/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.22.1",
    "helmet": "^7.2.0",
    "moment": "^2.22.1",
    "mongodb": "^5.9.0",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "mongodb-memory-server": "^11.2.0"
  }
}
