# Copia este fitxer a .env i omple només allò que necessites per a provar l'inici de sessió.
APP_PORT=3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL=
# Commons del xip de compte; buit = https://commons.edutictac.es. Commons local: http://edutictac.local:8082
EDUTICTAC_COMMONS_URL=
# Authentik simulat (servei oidc): port de l'amfitrió. Per a desactivar-lo, deixa AUTHENTIK_CLIENT_ID buit.
OIDC_PORT=8081
# AUTHENTIK_CLIENT_ID=
