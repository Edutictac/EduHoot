# Copia a /etc/eduhoot/stage.env y adapta valores
# chmod 640 /etc/eduhoot/stage.env

NODE_ENV=staging
PORT=3100

# Recomendado aislar también la BBDD de stage
MONGO_URL=mongodb://127.0.0.1:27017/eduhoot_stage
MONGO_DB=eduhoot_stage
MONGO_MAX_POOL_SIZE=20

# URL pública del entorno stage
PUBLIC_BASE_URL=https://stage.tu-dominio

# OAuth opcional para stage
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://stage.tu-dominio/api/auth/google/callback

# Sembrar automáticamente quizzes de ejemplo en cada arranque del servicio
# (por defecto, no; ver docs/STAGE_SETUP.md)
# AUTO_SEED_STAGE=1

# Redirecció a producció: amb una clau (mínim 12 caràcters), qui entra a stage
# va a producció, tret de qui entra una vegada amb https://<stage>/?dev=<clau>
# (queda guardat en una cookie de 90 dies). Sense clau, stage queda obert.
# STAGE_DEV_KEY=
# STAGE_REDIRECT_URL=https://eduhoot.edutictac.es
# STAGE_REDIRECT=off   # apaga la redirecció per a tothom (preval sobre l'ajust de l'admin)

