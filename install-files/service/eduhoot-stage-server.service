[Unit]
Description=EduHoot Stage Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/eduhoot-stage/src
EnvironmentFile=-/etc/eduhoot/stage.env
ExecStartPre=/bin/sh -c '[ "$AUTO_SEED_STAGE" = "1" ] && node /opt/eduhoot-stage/src/scripts/seed-stage-data.js || true'
ExecStart=/usr/bin/env node /opt/eduhoot-stage/src/server/server.js
Restart=always
RestartSec=2
RestartPreventExitStatus=0
StartLimitIntervalSec=200
StartLimitBurst=9
StandardOutput=append:/var/log/eduhoot-stage/server.log
StandardError=append:/var/log/eduhoot-stage/server.err.log

[Install]
WantedBy=multi-user.target
Alias=eduhoot-stage.service
